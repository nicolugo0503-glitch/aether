// Aether — data model
//
// LOCAL DEV:  DATABASE_URL="file:./dev.db"          (SQLite, no setup needed)
// PRODUCTION: DATABASE_URL="postgresql://..."        (Neon, Supabase, Railway)
//
// To switch to Postgres, change provider below to "postgresql"
// and update your DATABASE_URL in .env / Vercel env vars.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Plan stored as String — SQLite does not support enums.
// Values: "FREE" | "STARTER" | "GROWTH" | "SCALE"

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  createdAt    DateTime  @default(now())

  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  plan                 String    @default("FREE")
  planRenewsAt         DateTime?
  runsUsedThisPeriod   Int       @default(0)

  // Integration keys (stored per-user)
  resendApiKey  String?
  serperApiKey  String?
  fromEmail     String?

  // Social media — Meta (Facebook + Instagram)
  fbPageToken   String?
  fbPageId      String?
  igUserId      String?

  // Social media — X / Twitter
  twitterApiKey       String?
  twitterApiSecret    String?
  twitterAccessToken  String?
  twitterAccessSecret String?

  // Referral system
  referralCode      String?   @unique           // unique code this user shares
  referredBy        String?                      // referralCode of who referred them
  referralBonusRuns Int       @default(0)        // total bonus runs earned via referrals

  // Onboarding
  onboardingComplete Boolean  @default(false)

  // Email verification
  emailVerified     Boolean   @default(false)
  emailVerifyToken  String?   @unique

  // Password reset
  resetToken       String?   @unique
  resetTokenExpiry DateTime?

  // Social auto-schedule
  scheduleEnabled    Boolean   @default(false)
  scheduleTime       String    @default("09:00")   // "HH:MM" in user's chosen timezone
  scheduleTimezone   String    @default("UTC")
  scheduleFrequency  String    @default("daily")   // "daily" | "every2days" | "weekly"
  scheduleTopic      String?                        // null = AI picks randomly
  schedulePlatforms  String    @default("[\"facebook\",\"instagram\"]")
  scheduleNextRun    DateTime?

  agents      Agent[]
  runs        Run[]
  campaigns   Campaign[]
  socialPosts SocialPost[]
  feedbacks   Feedback[]

  ownedWorkspace       Workspace?        @relation("WorkspaceOwner")
  workspaceMemberships WorkspaceMember[] @relation("WorkspaceMembers")

  workflows    Workflow[]
  workflowRuns WorkflowRun[]

  competitors Competitor[]

  // Smart Inbox — inbound reply webhook
  inboxWebhookToken String?  @unique          // bearer secret for /api/inbox/inbound
  inboxNotifyHot    Boolean  @default(true)   // email user when a HOT reply arrives
  inboxLastSeenAt   DateTime?                  // for unread badge

  emailReplies EmailReply[]

  // Revenue Attribution — connects AI work to closed-won deals
  attributionWebhookToken String?  @unique     // bearer secret for /api/deals/webhook
  deals                   Deal[]
  attributionEvents       AttributionEvent[]

  // AI Predictive Churn Detection — latest risk snapshot for fast list rendering
  churnRiskScore     Int?                       // 0-100 (higher = more likely to churn)
  churnRiskTier      String?                    // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "HEALTHY"
  churnPredictedAt   DateTime?                  // when latest snapshot was generated

  churnPredictions   ChurnPrediction[]
}

model SocialPost {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  topic       String
  caption     String
  hashtags    String
  platforms   String   @default("[]")
  status      String   @default("draft")
  imageUrl    String?
  fbPostId    String?
  igPostId    String?
  xPostId     String?
  scheduledAt DateTime?
  postedAt    DateTime?
  error       String?
  createdAt   DateTime @default(now())
}

model Campaign {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  agentId   String
  name      String
  sheetUrl  String
  status    String   @default("idle")
  results   String   @default("[]")
  schedule  String?

  // AI Lead Scoring Engine
  scoringEnabled    Boolean  @default(true)            // run AI scoring before outreach
  minScoreThreshold Int      @default(0)               // 0 = email everyone, 50 = WARM+, 75 = HOT only
  sortByScore       Boolean  @default(true)            // process hottest leads first

  // ─────────────────────────────────────────────────────────────
  // Automated A/B Testing
  //
  // Run multiple email variants in parallel inside a single
  // campaign, track per-variant opens / clicks / replies / hot
  // replies, and auto-elect the statistically significant winner.
  // Once a winner is picked, all remaining leads receive that
  // variant — turning every campaign into a self-optimizing
  // outreach machine.
  // ─────────────────────────────────────────────────────────────
  abTestEnabled     Boolean   @default(false)
  abAutoPickWinner  Boolean   @default(true)            // auto-elect when significance threshold is hit
  abMinSampleSize   Int       @default(20)              // min sends per variant before auto-picking
  abConfidence      Int       @default(95)              // % confidence level required (90/95/99)
  abWinnerVariantId String?                             // set once a winner is locked in
  abWinnerPickedAt  DateTime?
  abWinnerMetric    String    @default("reply_rate")    // "reply_rate" | "hot_reply_rate" | "open_rate" | "click_rate"

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  leadScores LeadScore[]
  variants   CampaignVariant[]
}

// ─────────────────────────────────────────────────────────────
// CampaignVariant — one experimental treatment inside an A/B test.
//
// Variants are usually AI-generated by /api/campaigns/[id]/variants/generate
// from a single "base prompt" the user describes (tone, angle, hook).
// Each variant carries its own subjectTemplate + bodyTemplate that
// the campaign runner substitutes per lead ({{name}} / {{company}} /
// {{firstName}}) — so we get a controlled experiment instead of
// letting GPT free-form a new email per lead.
// ─────────────────────────────────────────────────────────────
model CampaignVariant {
  id         String   @id @default(cuid())
  campaignId String
  campaign   Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String

  label           String                                 // "A" | "B" | "C" | "D" ...
  name            String                                 // short human label e.g. "Pain-point hook"
  angle           String   @default("")                  // 1-line strategy ("lead with social proof")
  subjectTemplate String                                 // supports {{name}} / {{company}} / {{firstName}}
  bodyTemplate    String                                 // ditto
  tone            String   @default("professional")      // "professional" | "casual" | "bold" | "warm"

  // Traffic allocation (0-100). For 2 variants the runner defaults
  // to even split; weight lets users manually skew or boost a winner.
  weight     Int      @default(50)
  active     Boolean  @default(true)                     // false = stop sending this variant
  isControl  Boolean  @default(false)                    // the baseline / "A"
  isWinner   Boolean  @default(false)                    // sticky flag once elected

  // Aggregate counters — denormalized for fast dashboard render.
  sentCount       Int  @default(0)
  openedCount     Int  @default(0)
  clickedCount    Int  @default(0)
  repliedCount    Int  @default(0)
  hotRepliedCount Int  @default(0)
  errorCount      Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events VariantEvent[]

  @@index([campaignId])
  @@index([campaignId, label])
}

// One row per measurable event on a variant: sent / opened / clicked / replied / hot_reply / error.
// Stored separately so we can compute time-series, recompute aggregates, and link replies back.
model VariantEvent {
  id        String   @id @default(cuid())
  variantId String
  variant   CampaignVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)
  campaignId String
  userId     String

  // "sent" | "opened" | "clicked" | "replied" | "hot_reply" | "error"
  type       String

  leadEmail    String?
  leadName     String?
  replyId      String?                                   // links back to EmailReply for "replied" / "hot_reply"
  errorMessage String?

  createdAt  DateTime @default(now())

  @@index([variantId, createdAt])
  @@index([campaignId, type])
  @@index([userId, createdAt])
}

// AI-generated quality score for each lead in a campaign.
// Lets users see who is HOT before burning a run on them.
model LeadScore {
  id          String   @id @default(cuid())
  campaignId  String
  campaign    Campaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId      String

  leadEmail   String
  leadName    String
  leadCompany String?

  score       Int                                       // 1-100
  tier        String                                    // "HOT" | "WARM" | "COLD"
  reasoning   String                                    // 1-2 sentence why
  signals     String   @default("[]")                   // JSON array of positive signals
  redFlags    String   @default("[]")                   // JSON array of concerns

  contacted   Boolean  @default(false)                  // emailed in a run?
  skipped     Boolean  @default(false)                  // below threshold?

  createdAt   DateTime @default(now())

  @@index([campaignId])
  @@index([campaignId, score])
}

model Agent {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  role         String
  description  String?
  systemPrompt String
  model        String   @default("gpt-4o-mini")
  temperature  Float    @default(0.4)
  tools        String   @default("[]")
  knowledge    String   @default("")

  // Scheduled autonomous runs
  scheduleEnabled  Boolean   @default(false)
  scheduleCron     String?                    // "daily" | "every2days" | "weekly"
  scheduleInput    String?                    // default prompt for scheduled runs
  scheduleNextRun  DateTime?
  scheduleTimezone String    @default("UTC")

  // Agent Memory — AI-generated learnings from past runs
  memoryEnabled    Boolean   @default(false)
  memoryContext    String    @default("")     // compressed learnings injected into every run
  memoryUpdatedAt  DateTime?
  memoryRunCount   Int       @default(0)      // how many runs were analyzed to build this memory

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  runs Run[]
}

model Run {
  id          String    @id @default(cuid())
  agentId     String
  agent       Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  input       String
  output      String?
  status      String    @default("pending")
  tokensIn    Int       @default(0)
  tokensOut   Int       @default(0)
  costCents   Int       @default(0)
  error       String?
  triggeredBy String    @default("manual")   // "manual" | "cron"
  createdAt   DateTime  @default(now())
  finishedAt  DateTime?
}

// Cross-instance rate limiting — persisted in DB so serverless functions share state.
// Create/update with: npx prisma db push
model RateLimit {
  key     String   @id
  count   Int      @default(0)
  resetAt DateTime
}

// Team workspace
model Workspace {
  id        String   @id @default(cuid())
  name      String
  ownerId   String   @unique
  owner     User     @relation("WorkspaceOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  members WorkspaceMember[]
  invites WorkspaceInvite[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation("WorkspaceMembers", fields: [userId], references: [id], onDelete: Cascade)
  role        String    @default("member") // "owner" | "admin" | "member"
  joinedAt    DateTime  @default(now())

  @@unique([workspaceId, userId])
}

model WorkspaceInvite {
  id          String    @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email       String
  role        String    @default("member") // "admin" | "member"
  token       String    @unique @default(cuid())
  invitedById String
  expiresAt   DateTime
  createdAt   DateTime  @default(now())

  @@unique([workspaceId, email])
}

// User feedback / reviews
model Feedback {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  rating    Int                        // 1-5 stars
  message   String?
  page      String?                    // which page they were on
  createdAt DateTime @default(now())
}
// ─────────────────────────────────────────────────────────────────────
// Multi-Step Workflow Builder
//
// Chains multiple AI agents into a pipeline. Each step's output flows
// into the next step's input via {{step_N.output}} variables. Variables
// can also reference the initial trigger payload as {{input}}.
//
// Example: Rex (researches a company) → Ava (writes a cold email using
// the research) → Sage (drafts a follow-up if no reply in 3 days).
// ─────────────────────────────────────────────────────────────────────
model Workflow {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  description String?
  status      String   @default("draft")   // "draft" | "active" | "archived"

  // JSON array of WorkflowStep objects — see src/lib/workflow.ts for shape.
  steps       String   @default("[]")

  // Scheduled / triggered execution
  trigger          String    @default("manual")   // "manual" | "schedule" | "webhook"
  scheduleEnabled  Boolean   @default(false)
  scheduleCron     String?                         // "daily" | "every2days" | "weekly"
  scheduleInput    String?                         // default {{input}} payload for scheduled runs
  scheduleNextRun  DateTime?
  scheduleTimezone String    @default("UTC")

  // Webhook trigger
  webhookToken     String?   @unique               // bearer token for /api/workflows/{id}/trigger

  // Aggregate stats (denormalized for fast dashboard rendering)
  totalRuns        Int       @default(0)
  successfulRuns   Int       @default(0)
  totalCostCents   Int       @default(0)
  lastRunAt        DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs WorkflowRun[]

  @@index([userId])
  @@index([scheduleEnabled, scheduleNextRun])
}

model WorkflowRun {
  id          String   @id @default(cuid())
  workflowId  String
  workflow    Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  input       String   @default("")
  output      String?
  status      String   @default("pending")

  // Full execution trace — JSON array of StepResult objects.
  stepResults String   @default("[]")

  totalTokensIn  Int @default(0)
  totalTokensOut Int @default(0)
  totalCostCents Int @default(0)
  durationMs     Int @default(0)

  error       String?
  triggeredBy String  @default("manual")

  createdAt   DateTime  @default(now())
  finishedAt  DateTime?

  @@index([workflowId, createdAt])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────
// AI Competitor Intelligence Tracker
//
// Users register competitor URLs (pricing page, blog, homepage, careers).
// A daily cron fetches each tracked URL, diffs against the last snapshot,
// and if material change is detected, asks GPT to summarize what changed
// and why it matters. Notifications go to the dashboard + email.
//
// Use cases: pricing changes, new feature launches, hiring surges,
// messaging pivots, fundraising announcements.
// ─────────────────────────────────────────────────────────────────────
model Competitor {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String                                    // e.g. "Acme Corp — Pricing"
  url         String                                    // URL to monitor
  category    String   @default("general")              // "pricing" | "homepage" | "blog" | "careers" | "general"
  notes       String?                                   // user's notes on why they're tracking this

  // What user cares about — guides AI summary
  focus       String?                                   // e.g. "watch for pricing tier changes"

  // Tracking state
  enabled     Boolean  @default(true)
  frequency   String   @default("daily")                // "hourly" | "daily" | "weekly"
  notifyEmail Boolean  @default(true)                   // email user when change detected

  // Latest snapshot (for fast list-page rendering)
  lastContent      String?                              // truncated last extracted text (10k chars)
  lastHash         String?                              // sha256 of extracted text
  lastFetchedAt    DateTime?
  lastChangeAt     DateTime?
  lastError        String?

  // Aggregate stats
  totalScans       Int      @default(0)
  totalChanges     Int      @default(0)

  // Severity of latest detected change
  lastSeverity     String?                              // "low" | "medium" | "high" | "critical"
  lastSummary      String?                              // AI summary of the latest change

  // Scheduling
  nextScanAt       DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  snapshots CompetitorSnapshot[]
  changes   CompetitorChange[]

  @@index([userId])
  @@index([enabled, nextScanAt])
}

model CompetitorSnapshot {
  id            String     @id @default(cuid())
  competitorId  String
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)

  content       String                                  // extracted text (capped ~30k chars)
  contentHash   String                                  // sha256
  httpStatus    Int        @default(200)
  byteSize      Int        @default(0)
  fetchedAt     DateTime   @default(now())

  @@index([competitorId, fetchedAt])
}

model CompetitorChange {
  id            String     @id @default(cuid())
  competitorId  String
  competitor    Competitor @relation(fields: [competitorId], references: [id], onDelete: Cascade)
  userId        String                                   // denormalized for fast inbox query

  // What changed
  summary       String                                  // AI 1–2 sentence summary
  details       String     @default("")                 // longer AI analysis: what + why it matters
  severity      String                                  // "low" | "medium" | "high" | "critical"
  signals       String     @default("[]")               // JSON: tags like ["pricing","new-feature","hiring"]

  // Diff context
  beforeHash    String?
  afterHash     String
  charsAdded    Int        @default(0)
  charsRemoved  Int        @default(0)

  // AI cost
  tokensIn      Int        @default(0)
  tokensOut     Int        @default(0)
  costCents     Int        @default(0)

  // User interaction
  read          Boolean    @default(false)
  pinned        Boolean    @default(false)
  emailedAt     DateTime?

  detectedAt    DateTime   @default(now())

  @@index([competitorId, detectedAt])
  @@index([userId, read])
}

// ─────────────────────────────────────────────────────────────────────
// Smart Inbox — AI-Powered Reply Intelligence
//
// Inbound email replies arrive via webhook (e.g. Resend Inbound, or a
// custom MX hook). Each reply is classified by GPT-4o-mini into a clean
// intent (HOT / INTERESTED / OBJECTION / NOT_NOW / UNSUBSCRIBE /
// OUT_OF_OFFICE / WRONG_PERSON / QUESTION / SPAM), scored 1-100, and
// a draft response is pre-generated.
//
// Closes the loop on outbound cold email: instead of every reply
// landing back in the user's noisy personal inbox, Aether surfaces
// the hot ones, summarizes the rest, and offers one-click follow-ups.
// ─────────────────────────────────────────────────────────────────────
model EmailReply {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Optional link back to the campaign that sent the original outreach
  campaignId String?

  // The lead who replied
  fromEmail  String
  fromName   String?
  toEmail    String?                                  // the address that received it
  subject    String?

  // Reply content (truncated to ~16k chars to keep DB lean)
  bodyText   String   @default("")
  bodyHtml   String?

  // Threading
  messageId   String?                                  // RFC822 Message-ID of this reply
  inReplyTo   String?                                  // Message-ID of the email we sent
  threadId    String?                                  // optional provider thread id

  // AI classification — see src/lib/reply-intelligence.ts
  intent           String   @default("UNCLASSIFIED")   // HOT | INTERESTED | OBJECTION | NOT_NOW | UNSUBSCRIBE | OUT_OF_OFFICE | WRONG_PERSON | QUESTION | SPAM | UNCLASSIFIED
  sentiment        String   @default("neutral")         // positive | neutral | negative
  score            Int      @default(50)                // 1-100, "how worth your time" composite
  urgency          String   @default("normal")          // low | normal | high
  summary          String   @default("")                // 1-2 sentence AI summary
  suggestedAction  String   @default("")                // e.g. "Send Calendly link" / "Send pricing" / "Move to nurture"
  draftReply       String   @default("")                // AI-generated reply the user can edit & send
  tags             String   @default("[]")              // JSON array of short tags

  // User state
  status     String    @default("new")                  // "new" | "read" | "actioned" | "dismissed"
  pinned     Boolean   @default(false)
  hot        Boolean   @default(false)                  // shortcut for "intent=HOT or score>=80"

  // Replied / actioned tracking
  repliedAt   DateTime?
  actionedAt  DateTime?
  notifiedAt  DateTime?                                  // when we emailed the user about this

  // AI cost
  tokensIn   Int @default(0)
  tokensOut  Int @default(0)
  costCents  Int @default(0)

  receivedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId, receivedAt])
  @@index([userId, status])
  @@index([userId, hot])
  @@index([campaignId])
}

// ─────────────────────────────────────────────────────────────────────
// Revenue Attribution & Sales Pipeline
//
// The holy grail of an AI-workforce product: prove that the AI made
// the user money. Every meaningful action by an Aether agent — a sent
// cold email, a generated post, a hot reply detected — emits an
// AttributionEvent that can later be linked to a Deal. Stripe + Calendly
// webhooks can mark deals won/lost without the user lifting a finger.
//
// Pipeline stages (string-typed for SQLite-safe portability):
//   "NEW" | "CONTACTED" | "QUALIFIED" | "DEMO" | "PROPOSAL" | "WON" | "LOST"
// ─────────────────────────────────────────────────────────────────────
model Deal {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Lead identity
  leadEmail   String
  leadName    String?
  company     String?
  title       String?
  linkedinUrl String?

  // Pipeline
  stage       String   @default("NEW")

  // Money (cents to avoid float drift)
  valueCents       Int     @default(0)
  currency         String  @default("USD")
  probability      Int     @default(20)
  expectedRevenue  Int     @default(0)

  // Attribution — which AI work created this deal
  sourceAgentId    String?
  sourceCampaignId String?
  sourceRunId      String?
  sourceReplyId    String?
  sourceType       String  @default("manual")   // "manual" | "hot_reply" | "webhook" | "social" | "workflow"

  notes        String   @default("")
  positionRank Int      @default(0)

  // Lifecycle
  contactedAt     DateTime?
  qualifiedAt     DateTime?
  demoBookedAt    DateTime?
  proposalAt      DateTime?
  expectedCloseAt DateTime?
  closedAt        DateTime?
  closeReason     String?

  // Aggregates (denormalized)
  eventCount   Int       @default(0)
  lastEventAt  DateTime?
  daysInStage  Int       @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  events AttributionEvent[]

  @@index([userId, stage])
  @@index([userId, updatedAt])
  @@index([userId, leadEmail])
  @@index([sourceAgentId])
  @@index([sourceCampaignId])
}

// Every meaningful interaction with a lead/deal is logged here.
model AttributionEvent {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  dealId   String?
  deal     Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  type     String
  title    String
  detail   String   @default("")

  agentId       String?
  runId         String?
  campaignId    String?
  replyId       String?
  workflowRunId String?

  valueCents Int     @default(0)
  source     String  @default("internal")   // "internal" | "calendly" | "stripe" | "zapier" | "custom"
  metadata   String  @default("{}")

  createdAt  DateTime @default(now())

  @@index([userId, createdAt])
  @@index([dealId, createdAt])
  @@index([userId, type])
}

// ─────────────────────────────────────────────────────────────────────
// AI Predictive Churn Detection
//
// Every day, a cron scans the active user base, computes behavioral
// signals (run cadence, plan, days-since-login, setup completion, error
// rate, declining usage trend), and asks GPT-4o-mini to:
//   1. Score 30-day churn risk on a 0-100 scale
//   2. Bucket into a tier (CRITICAL / HIGH / MEDIUM / LOW / HEALTHY)
//   3. Produce a short executive reasoning
//   4. List the strongest red-flag signals
//   5. Recommend a specific save action ("send re-engagement email",
//      "offer 1:1 onboarding call", "downgrade-prevention discount")
//
// CSMs use the resulting list to triage outreach: who to call today,
// who to email, who is healthy and can be left alone. Turns vague
// "are we losing them?" worries into a ranked, explainable workqueue.
// ─────────────────────────────────────────────────────────────────────
model ChurnPrediction {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // The prediction itself
  riskScore   Int                                       // 0-100, higher = more likely to cancel
  riskTier    String                                    // "CRITICAL" | "HIGH" | "MEDIUM" | "LOW" | "HEALTHY"
  reasoning   String                                    // 2-3 sentence executive summary

  // Strongest behavioral red flags (JSON array of short strings, max 5)
  redFlags    String   @default("[]")
  // Positive signals that offset risk (JSON array of short strings, max 3)
  greenFlags  String   @default("[]")

  // The save play we recommend a CSM run
  saveAction      String   @default("")                 // e.g. "Personal onboarding call", "Re-engagement email"
  saveActionType  String   @default("none")             // "email" | "call" | "discount" | "tutorial" | "none"
  savePriority    String   @default("normal")           // "urgent" | "high" | "normal" | "low"

  // Frozen signal snapshot — useful for trend analysis later
  signalsJson String   @default("{}")

  // AI cost accounting
  model       String   @default("gpt-4o-mini")
  tokensIn    Int      @default(0)
  tokensOut   Int      @default(0)
  costCents   Int      @default(0)

  // CSM workflow state — when an operator reviews/dismisses
  reviewed     Boolean   @default(false)
  reviewedAt   DateTime?
  reviewerNote String    @default("")
  outcome      String?                                  // "saved" | "churned" | "still_at_risk" | null

  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([riskScore])
  @@index([riskTier, createdAt])
}
